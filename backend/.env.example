# backend/.env.example — Template only. Copy to .env and fill in secrets.
# Never commit .env to version control.

# ── Canonical MongoDB store ─────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=pragyan_ppi

# ── OpenAI: chat + embeddings ──────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Must equal QDRANT_VECTOR_SIZE
OPENAI_EMBEDDING_DIMENSIONS=1024
OPENAI_TEMPERATURE=0.1

# ── Qdrant: local Docker service ───────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=pragyan_evidence_v1
QDRANT_VECTOR_SIZE=1024

# ── Neo4j: local Docker service ────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=local_secret_only
NEO4J_DATABASE=neo4j

# ── RAG feature flags ──────────────────────────────────────────────────────
RAG_VECTOR_ENABLED=true
RAG_GRAPH_ENABLED=true
RAG_ALLOW_EXTERNAL_LLM=false

# ── Retrieval configuration ────────────────────────────────────────────────
RAG_MAX_CHUNKS=10
RAG_VECTOR_TOP_K=15
RAG_SCORE_THRESHOLD=0.30
RAG_GRAPH_MAX_HOPS=2
