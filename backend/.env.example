# backend/.env.example — Template only. Copy to .env and fill in secrets.
# Never commit .env to version control.

# ── Canonical MongoDB store ─────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=pragyan_ppi

# ── Ollama: native Windows host (no API key required) ──────────────────────
# Backend running directly on Windows → localhost; inside Docker → host.docker.internal
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
OLLAMA_TEMPERATURE=0.1
OLLAMA_CONTEXT_WINDOW=4096

# ── Qdrant: local Docker service ───────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=pragyan_evidence_v1
QDRANT_VECTOR_SIZE=1024

# ── Neo4j: local Docker service ────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=local_secret_only
NEO4J_DATABASE=neo4j

# ── RAG feature flags ──────────────────────────────────────────────────────
RAG_VECTOR_ENABLED=true
RAG_GRAPH_ENABLED=true
RAG_ALLOW_EXTERNAL_LLM=false

# ── Retrieval configuration ────────────────────────────────────────────────
RAG_MAX_CHUNKS=10
RAG_VECTOR_TOP_K=15
RAG_SCORE_THRESHOLD=0.30
RAG_GRAPH_MAX_HOPS=2
